# Local development only. Copy to .env; do not commit real credentials.
# HTTP_ADDR and ADMIN_ADDR are service-specific: gateway 8080/8090,
# campaign-service 8081/8091, event-aggregator 8083/8093.
# Mock-bidder/seed admin defaults: :8094 / :8095.
# Native commands read process environment; they do not automatically source .env.
SERVICE_NAME=bid-gateway
LOG_LEVEL=info
HTTP_ADDR=:8080
ADMIN_ADDR=:8090
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_SAMPLER_ARG=0.01
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=15s
ENABLE_TEST_ENDPOINTS=false

# Gateway
PUBLIC_BASE_URL=http://localhost:8080
CAMPAIGN_GRPC_ADDR=localhost:8082
SNAPSHOT_REFRESH_INTERVAL=2s
BIDDER_DEADLINE_MS=100
REQUEST_MAX_BYTES=16384
REDIS_ADDR=localhost:6379
REDIS_OP_TIMEOUT_MS=10
PACING_BURST_FRACTION=0.02
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_EVENTS=pulsebid.events.v1
EVENT_BUFFER_SIZE=100000
EVENT_TOKEN_SECRET=local-development-only-replace-before-deploying
EVENT_TOKEN_TTL=24h
BIDDER_MAX_INFLIGHT=512
CB_MIN_REQUESTS=20
CB_FAILURE_RATIO=0.5
CB_OPEN_FOR=5s
MAX_AUCTION_ATTEMPTS=3

# Campaign service
GRPC_ADDR=:8082
DATABASE_URL=postgres://pulsebid:pulsebid@localhost:5432/pulsebid?sslmode=disable
API_KEYS=dev-key

# Optional Compose-only host port override if a local PostgreSQL already uses 5432.
# Also change DATABASE_URL for native applications when overriding this port.
POSTGRES_PORT=5432

# Event aggregator
KAFKA_TOPIC_DLQ=pulsebid.events.dlq.v1
CONSUMER_GROUP=pulsebid-aggregator
BATCH_SIZE=500
FLUSH_INTERVAL_MS=200
DEDUP_RETENTION=168h

# Mock bidder: --count 8 --base-port 9101
LATENCY_MS=10
JITTER_MS=15
ERROR_RATE=0
TIMEOUT_RATE=0
NO_BID_RATE=0.05
BID_MODE=fixed
BID_SHADE=0.9
SEED=1

# Seed command
BIDDER_HOST=localhost
SEED_CAMPAIGNS=40
