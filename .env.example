# Local Compose console credentials. Replace both before starting.
ADMIN_PASSWORD=choose-a-local-console-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PULSEBID_API_KEY=dev-key
API_KEYS=dev-key
APP_ORIGIN=http://localhost:3001
GATEWAY_PUBLIC_URL=http://localhost:8080
# Windows on this workspace reserves 5432. Use 5432 elsewhere if preferred.
POSTGRES_PORT=55432
